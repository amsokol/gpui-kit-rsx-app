+    /// The weight a face is used at when `requested` is asked of it: a variable face takes
+    /// the requested one, within its range; a static face has only its own.
+    fn instance_weight(
+        &mut self,
+        database_id: cosmic_text::fontdb::ID,
+        requested: Weight,
+    ) -> Result<Weight> {
+        let font = self
+            .font_system
+            .get_font(database_id, Weight::NORMAL)
+            .context("Could not load font")?;
+        if let Some(axis) = font.as_swash().variations().find_by_tag(WEIGHT_AXIS) {
+            let weight = f32::from(requested.0).clamp(axis.min_value(), axis.max_value());
+            return Ok(Weight(weight as u16));
+        }
+        let face = self.font_system.db().face(database_id);
+        Ok(face.context("font face not found")?.weight)
+    }
