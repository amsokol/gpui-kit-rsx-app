+const WEIGHT_AXIS: swash::Tag = swash::tag_from_bytes(b"wght");
+
+fn variation_coords(font: &CosmicTextFont, weight: Weight) -> Arc<[swash::NormalizedCoord]> {
+    let variations = font.as_swash().variations();
+    if variations.find_by_tag(WEIGHT_AXIS).is_none() {
+        return Arc::from([]);
+    }
+    variations
+        .normalized_coords([(WEIGHT_AXIS, f32::from(weight.0))])
+        .collect()
+}
+
+impl LoadedFont {
+    fn glyph_metrics(&self) -> swash::GlyphMetrics<'_> {
+        self.font.as_swash().glyph_metrics(&self.coords)
+    }
